# ── Supabase Project ─────────────────────────────────────────────────────
# Found in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose with NEXT_PUBLIC_ prefix.
# Used for: tenant provisioning, staff invitation, and any action that must
# bypass RLS intentionally (always paired with manual tenant_id checks in code).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Drizzle) ───────────────────────────────────────────────────
# DIRECT connection (port 5432) — required for drizzle-kit generate/migrate.
# Supabase Dashboard → Project Settings → Database → Connection string → "URI" (Direct)
# Pooled/pgbouncer (port 6543) connections don't support the prepared
# statements drizzle-kit relies on for migrations.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# POOLED connection (port 6543, pgbouncer transaction mode) — used by the
# app's runtime query client for regular request-time queries. Keeps
# connection count low under load.
DATABASE_POOL_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000